# Keep REST calls browser-relative under /api.
VITE_API_HTTP=
VITE_API_WS=
VITE_SCADA_WS_URL=
VITE_BACKEND_WS_PORT=8090
VITE_USE_DIRECT_BACKEND=false
VITE_DIRECT_BACKEND_ORIGIN=
# Optional: force product API prefix ("crystal" or "small"). Empty = auto-detect + fallback.
VITE_PRODUCT_TYPE=

VITE_API_PREFIX=/api

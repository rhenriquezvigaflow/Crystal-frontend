# Keep empty so REST calls stay browser-relative under /api.
VITE_API_HTTP=
VITE_API_WS=
VITE_SCADA_WS_URL=
VITE_BACKEND_WS_PORT=
VITE_USE_DIRECT_BACKEND=false
VITE_DIRECT_BACKEND_ORIGIN=
# Optional: force product API prefix ("crystal" or "small"). Empty = auto-detect + fallback.
VITE_PRODUCT_TYPE=

# Vite dev server runtime:
# - iis  -> app opened through https://localhost (IIS reverse proxy)
# - vite -> app opened directly through http://localhost:5173
VITE_DEV_RUNTIME_MODE=vite
# In IIS mode, keep false unless /vite-hmr websocket reverse proxy is verified.
VITE_IIS_HMR=false
VITE_DEV_BACKEND_HTTP_TARGET=http://127.0.0.1:8090
VITE_DEV_BACKEND_WS_TARGET=ws://127.0.0.1:8090

VITE_API_PREFIX=/api
